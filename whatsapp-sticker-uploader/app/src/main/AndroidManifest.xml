<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permessi per leggere i file degli sticker dalla memoria -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickerUploader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            ContentProvider richiesto dall'API ufficiale WhatsApp Sticker Pack.
            L'authority DEVE corrispondere all'applicationId + ".stickercontentprovider"
            oppure un valore personalizzato dichiarato anche nelle meta-data dell'app.
        -->
        <provider
            android:name=".StickerContentProvider"
            android:authorities="com.stickeruploader.stickercontentprovider"
            android:exported="true"
            android:readPermission="com.whatsapp.permission.STICKER_PROVIDER_READ" />

        <!-- Meta-data richiesti dall'API WhatsApp -->
        <meta-data
            android:name="content_provider_authority"
            android:value="com.stickeruploader.stickercontentprovider" />

    </application>

</manifest>
