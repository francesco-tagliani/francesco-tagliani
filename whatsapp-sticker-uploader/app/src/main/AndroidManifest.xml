<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 10 e inferiori -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Android 11+ (API 30+): accesso completo necessario per Android/media/com.whatsapp/ -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StickerUploader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name=".StickerContentProvider"
            android:authorities="com.stickeruploader.stickercontentprovider"
            android:exported="true"
            android:enabled="true"
            android:readPermission="com.whatsapp.sticker.READ" />

        <meta-data
            android:name="content_provider_authority"
            android:value="com.stickeruploader.stickercontentprovider" />

    </application>

</manifest>
